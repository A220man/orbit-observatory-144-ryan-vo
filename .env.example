# Database
DATABASE_URL=sqlite+aiosqlite:///./orbit.db

# Keycloak/OIDC
OIDC_ISSUER_URL=http://localhost:8080/realms/orbit
OIDC_CLIENT_ID=orbit-observatory
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/callback

# LLM (opt-in, advisory only)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# Compression
COMPRESS_MODEL_CONTEXT_LIMIT=100000
COMPRESS_MAX_CONTEXT_LIMIT="60%"
COMPRESS_NUDGE_GROWTH_TOKENS=50000
COMPRESS_REASONING_DROP=false
DSH_ALLOW_DSH_COMPACTION=false
TRAE_COMPACT_ENABLED=true

# Diagnostics
DIAGNOSTICS_LOG_RETENTION_DAYS=7
DIAGNOSTICS_MAX_TOTAL_BYTES=100000000